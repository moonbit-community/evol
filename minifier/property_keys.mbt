///|
fn is_property_quote(character : UInt16) -> Bool {
  character == '\'' || character == '"' || character == '`'
}

///|
fn ascii_property_name(name : String) -> Bool {
  guard name.length() > 0 else { return false }
  let mut first = true
  for c in name.iter() {
    guard is_ascii_identifier_character(c, first) else { return false }
    first = false
  }
  true
}

///|
/// Decode static ASCII identifier keys, including JS escapes. Other values
/// cannot collide with the ASCII property names generated by this pass.
fn quoted_property_name(source : String, start : Int, end : Int) -> String? {
  let text = StringBuilder()
  let content_end = end - 1
  for index = start + 1 {
    guard index < content_end else { break }
    guard read_property_character(source, index, content_end) is Some(part) else {
      return None
    }
    match part {
      LineContinuation(next) => continue next
      Character(character, next) => {
        guard is_ascii_identifier_character(character, text.is_empty()) else {
          return None
        }
        text.write_char(character)
        continue next
      }
    }
  }
  if text.is_empty() {
    None
  } else {
    Some(text.to_string())
  }
}

///|
/// Each part carries the source position immediately after it.
priv enum PropertyCharacter {
  Character(Char, Int)
  LineContinuation(Int)
}

///|
fn read_property_character(
  source : String,
  index : Int,
  end : Int,
) -> PropertyCharacter? {
  let (code_point, next) = if source[index] != '\\' {
    (source[index].to_int(), index + 1)
  } else {
    let escape = source[index + 1]
    let after_escape = index + 2
    if is_line_terminator(escape) {
      let next = if escape == '\r' &&
        after_escape < end &&
        source[after_escape] == '\n' {
        after_escape + 1
      } else {
        after_escape
      }
      return Some(LineContinuation(next))
    }
    let decoded = match escape {
      'x' => read_fixed_property_hex(source, after_escape, end, 2)
      'u' if after_escape < end && source[after_escape] == '{' =>
        read_braced_property_hex(source, after_escape + 1, end)
      'u' => read_fixed_property_hex(source, after_escape, end, 4)
      _ if is_oct(escape) => Some(read_property_octal(source, index + 1, end))
      // These escapes produce control characters, never identifier characters.
      'b' | 'f' | 'n' | 'r' | 't' | 'v' => return None
      _ => Some((escape.to_int(), after_escape))
    }
    guard decoded is Some(result) else { return None }
    result
  }
  guard code_point.to_char() is Some(character) else { return None }
  Some(Character(character, next))
}

///|
fn read_fixed_property_hex(
  source : String,
  start : Int,
  end : Int,
  digit_count : Int,
) -> (Int, Int)? {
  let digits_end = start + digit_count
  guard digits_end <= end else { return None }
  for index = start, code_point = 0 {
    guard index < digits_end else { break Some((code_point, digits_end)) }
    guard hex_digit_value(source[index]) is Some(digit) else { return None }
    let decoded = code_point * 16 + digit
    guard decoded < 0x80 else { return None }
    continue index + 1, decoded
  }
}

///|
fn read_braced_property_hex(
  source : String,
  start : Int,
  end : Int,
) -> (Int, Int)? {
  for index = start, code_point = 0 {
    guard index < end else { return None }
    if source[index] == '}' {
      guard index > start else { return None }
      break Some((code_point, index + 1))
    }
    guard hex_digit_value(source[index]) is Some(digit) else { return None }
    let decoded = code_point * 16 + digit
    guard decoded < 0x80 else { return None }
    continue index + 1, decoded
  }
}

///|
fn read_property_octal(source : String, start : Int, end : Int) -> (Int, Int) {
  let first_digit = source[start]
  let digit_limit = if first_digit <= '3' { 3 } else { 2 }
  for index = start + 1, code_point = first_digit.to_int() - '0'.to_int() {
    let has_next_digit = index < end && index - start < digit_limit
    guard has_next_digit && is_oct(source[index]) else {
      break (code_point, index)
    }
    let digit = source[index].to_int() - '0'.to_int()
    continue index + 1, code_point * 8 + digit
  }
}

///|
fn property_leaf(program : Program, id : Int) -> Int {
  for current = id {
    let node = program.nodes[current]
    guard node.kind == Parenthesized else { break current }
    continue node.a
  }
}
